# ===== ResumeIQ Calling Agent — environment =====
# Copy this file to ".env" and fill in your real values.

# REQUIRED — from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_MODEL=gpt-realtime
# OPENAI_VOICE=verse
# PORT=8090

# Protects the /orders admin page
ORDERS_TOKEN=change-me-to-a-secret

# Business details spoken by the agent
BUSINESS_NAME=ResumeIQ
SUPPORT_WHATSAPP=919999999999
SUPPORT_EMAIL=support@resumeiq.in
UPI_ID=resumeiq@upi

# Only needed if you send WhatsApp order notifications (future)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
